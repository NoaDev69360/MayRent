# .env.test
# Configuration pour l'environnement de test (APP_ENV=test)

APP_SECRET='$ecretf0rt3st'
SYMFONY_DEPRECATIONS_HELPER=999999

###> lexik/jwt-authentication-bundle ###
# Configuration pour que le système d'authentification JWT fonctionne pendant les tests.
# IMPORTANT : la passphrase doit être la même que celle utilisée pour générer vos clés.
JWT_SECRET_KEY=%kernel.project_dir%/config/jwt/private.pem
JWT_PUBLIC_KEY=%kernel.project_dir%/config/jwt/public.pem
JWT_PASSPHRASE=dev
###< lexik/jwt-authentication-bundle ###

###> doctrine/doctrine-bundle ###
# Utilisation d'une base de données SQLite stockée dans un fichier pour les tests.
# C'est rapide et complètement isolé de votre base de données de développement.
DATABASE_URL="sqlite:///%kernel.project_dir%/var/test.db"
###< doctrine/doctrine-bundle ###